# ==============================================================================
# ms-eventomax-productions — Production Environment Template (.env.prod.example)
# ==============================================================================

# PostgreSQL / Flyway (Schema: productions)
DB_URL=jdbc:postgresql://<POSTGRES_HOST>:5432/eventomax?currentSchema=productions
DB_USER=eventomax_prod
DB_PASSWORD=<CHANGE_ME_STRONG_DB_PASSWORD>
DB_SCHEMA=productions
FLYWAY_CREATE_SCHEMAS=true

# Catalog internal HTTP endpoint
CATALOG_BASE_URL=http://ms-eventomax-catalog:8080

# RabbitMQ 2-Node Cluster
SPRING_RABBITMQ_ADDRESSES=rabbitmq-1:5672,rabbitmq-2:5672
RABBITMQ_HOST=rabbitmq-1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=eventomax_app
RABBITMQ_PASSWORD=<CHANGE_ME_STRONG_RABBIT_PASSWORD>
RABBITMQ_VHOST=/

# Microsoft Entra ID OAuth2 Resource Server
ENTRA_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0
ENTRA_AUDIENCE=api://<BACKEND_API_CLIENT_ID>

# Kafka Outbox Relay (used when Outbox events are relayed to Report/Audit)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_PRODUCTIONS=productions.events

# JVM Memory Budget (Container mem_limit: 640m)
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=65.0 -XX:+ExitOnOutOfMemoryError
